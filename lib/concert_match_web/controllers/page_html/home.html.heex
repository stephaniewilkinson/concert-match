<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="py-12 text-center space-y-8">
    <div class="space-y-4">
      <img
        src={~p"/images/logo-large.png"}
        alt=""
        width="180"
        class="mx-auto"
      />
      <h1 class="text-4xl font-bold tracking-tight">
        Concerts you and your friends both want to see
      </h1>
      <p class="mx-auto max-w-xl text-lg opacity-80">
        Concert Match reads what you actually listen to on Spotify, compares it against
        your friends, and emails you when a show gets announced that more than one of
        you would turn up for.
      </p>
    </div>

    <div :if={@current_user}>
      <.link navigate={~p"/home"} class="btn btn-primary btn-lg">
        See your matches
      </.link>
    </div>

    <div :if={is_nil(@current_user)} class="space-y-3">
      <a href={~p"/auth/spotify"} class="btn btn-primary btn-lg">
        Log in with Spotify
      </a>
      <p class="text-sm opacity-60">
        Spotify limits apps like this one to five people. If you weren't added to the
        list, login will be refused.
      </p>
    </div>
  </div>
</Layouts.app>
