<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="py-12 text-center space-y-8">
    <div class="space-y-4">
      <img
        src={~p"/images/logo-large.png"}
        alt=""
        width="180"
        class="mx-auto"
      />
      <h1 class="text-4xl font-bold tracking-tight">
        Concerts you and your friends both want to see
      </h1>
      <p class="mx-auto max-w-xl text-lg opacity-80">
        Concert Match reads what you actually listen to on Spotify, compares it against
        your friends, and emails you when a show gets announced that more than one of
        you would turn up for. Listening, not following — nobody unfollows a band, so
        follows say very little about who you'd cross town for.
      </p>
    </div>

    <div :if={@current_user}>
      <.link navigate={~p"/home"} class="btn btn-primary btn-lg">
        See your matches
      </.link>
    </div>

    <div :if={is_nil(@current_user)} class="space-y-3">
      <a href={~p"/auth/spotify"} class="btn btn-primary btn-lg">
        Log in with Spotify
      </a>
      <p class="mx-auto max-w-md text-sm opacity-60">
        Spotify only lets an app like this one have five people, and each one has to
        be added by hand. If you want in, send whoever runs this the email address on
        your Spotify account — that's the only thing they need. Until then, logging in
        will get you as far as the front door and no further.
      </p>
    </div>
  </div>
</Layouts.app>
