# Copy to .env and fill in. .env is gitignored -- keep it that way.
# Load it however you like: direnv, `set -a; source .env; set +a`, etc.

# Spotify app credentials, from https://developer.spotify.com/dashboard
# The redirect URI must be registered on the app exactly as it appears here.
# Spotify requires an explicit loopback IP rather than "localhost".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/auth/spotify/callback

# Ticketmaster Discovery API key, from https://developer-acct.ticketmaster.com
# Free tier: 5000 calls/day, 5 requests/second.
TICKETMASTER_API_KEY=
